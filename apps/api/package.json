{
  "name": "@factoryos/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput & node --env-file-if-exists=../../.env --watch dist/main.js",
    "start": "node dist/main.js",
    "seed:superadmin": "node --env-file-if-exists=../../.env dist/cli/seed-superadmin.js"
  },
  "devDependencies": {
    "@factoryos/config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@factoryos/auth": "workspace:*",
    "@factoryos/compliance-in": "workspace:*",
    "@factoryos/core": "workspace:*",
    "@factoryos/db": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "files": [
    "dist"
  ]
}
