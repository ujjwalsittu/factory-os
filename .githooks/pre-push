#!/usr/bin/env bash
# Pre-push guard: re-check every commit message about to be pushed.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
fail=0
while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "$zero" ] && continue
  if [ "$rsha" = "$zero" ]; then range="$lsha --not --remotes"; else range="$rsha..$lsha"; fi
  for c in $(git rev-list $range); do
    if ! git log -1 --format=%B "$c" | "$root/scripts/check-message.sh" - ; then
      echo "  in commit $c" >&2; fail=1
    fi
  done
done
exit $fail
