# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgresql://factoryos:factoryos@localhost:5432/factoryos

# API
PORT=4000
# Public URL where the browser reaches /api/auth. The web app proxies /api to the API, so this is the web origin.
BETTER_AUTH_URL=http://localhost:3000
# 32+ random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars
WEB_ORIGIN=http://localhost:3000
# Optional, comma-separated: extra origins the web app is served from
EXTRA_TRUSTED_ORIGINS=
MIGRATE_ON_START=true
ALLOW_SELF_SERVE_TENANTS=true
# Optional: first-run SuperAdmin promotion (see apps/api/src/bootstrap.ts)
BOOTSTRAP_SUPERADMIN_EMAIL=

# Web (server-side): where Next.js proxies /api/* to
API_INTERNAL_URL=http://localhost:4000

# Coolify MCP (for agents; see docs/16). Set in your shell, not here.
# COOLIFY_API_TOKEN=

# Optional sandbox NIC credential encryption: canonical base64 32-byte key, secure environment setting.
# Mock sandbox operations require no credential key.
GSP_CREDENTIAL_KEY_V1=

# Transactional email: disabled preserves manual invitation flow; never logs auth links once integrated.
EMAIL_MODE=disabled
EMAIL_WORKER_ENABLED=false
# SMTP mode requires sender/host/port/TLS and the separate canonical base64 32-byte key.
# TLS: implicit-tls or starttls-required; plaintext-loopback-test is dev/test-only.
SMTP_HOST=
SMTP_PORT=
SMTP_TLS=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=FactoryOS
EMAIL_REPLY_TO=
EMAIL_PAYLOAD_KEY_V1=
# Email API/worker also share BETTER_AUTH_SECRET, BETTER_AUTH_URL and WEB_ORIGIN above.

# Operational mail request limits (hashed evidence; no account-existence result)
EMAIL_RESET_MAX_PER_HOUR=5
EMAIL_ORIGIN_MAX_PER_10_MIN=30
EMAIL_VERIFICATION_MAX_PER_HOUR=5
EMAIL_VERIFICATION_COOLDOWN_SECONDS=60

# Optional existing-account SSO; enable only after registering exact callback URLs.
# Secrets remain server-side. Microsoft requires one organization UUID.
SSO_GOOGLE_ENABLED=false
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
# Exact signed Workspace domains, comma-separated; empty permits linked personal accounts.
SSO_GOOGLE_ALLOWED_HOSTED_DOMAINS=
SSO_MICROSOFT_ENABLED=false
SSO_MICROSOFT_CLIENT_ID=
SSO_MICROSOFT_CLIENT_SECRET=
SSO_MICROSOFT_TENANT_ID=

# Optional existing-account passkeys; disabled by default until configured and accepted.
# RP ID is exactly the canonical WEB_ORIGIN host, without scheme or port.
PASSKEY_ENABLED=false
# Set only when enabled; example production RP: factoryos.azeonics.com
PASSKEY_RP_ID=
# Exact comma-separated origins within RP/core trust; omit to use WEB_ORIGIN.
# PASSKEY_ALLOWED_ORIGINS=https://factoryos.azeonics.com
PASSKEY_MAX_PER_USER=10
# ── Certificates and attachments (decision 048) ──
# s3 = Cloudflare R2 (or any S3-compatible store); local = a folder, development and tests only; empty = uploads refused.
STORAGE_DRIVER=
# R2: https://<account id>.r2.cloudflarestorage.com, region "auto". Keep the keys in Coolify, never in git.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# local driver folder (default .storage, gitignored)
STORAGE_LOCAL_DIR=
# Platform → Storage (decision 051): the platform owner can save the R2 settings in the app instead of the S3_* variables.
# The secret is encrypted with this key: base64 of 32 random bytes (openssl rand -base64 32). Keep it in Coolify only.
# STORAGE_DRIVER, when set, overrides the saved settings.
STORAGE_CREDENTIAL_KEY_V1=
